# Copy to .env and fill in. `.env` is gitignored — never commit real credentials.

# Supabase Session Pooler connection string (Dashboard -> Connect -> Session pooler).
# The pooler (not the direct db.*.supabase.co host) is required: GitHub Actions
# runners are IPv4-only and Supabase's direct host is IPv6-only.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres
