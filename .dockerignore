# Keep the build context small and secrets out of it. The Dockerfile copies
# only agent/ and frontend/ (and builds the frontend fresh), so nothing else
# is needed.
.git
.github
.venv
**/__pycache__
*.pyc
.pytest_cache
**/node_modules
frontend/dist
tests
etl
supabase
*.md
.env
.env.example
main.py
